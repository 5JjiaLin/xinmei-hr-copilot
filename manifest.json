{
  "manifest_version": 3,
  "name": "新美九天 AI HR Copilot",
  "description": "BOSS 招聘页操作验证：滚动列表、查看简历、原生招呼和继续浏览。附合成筛选演示。",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting"],
  "optional_host_permissions": ["https://www.zhipin.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 HR 侧栏" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'" }
}
